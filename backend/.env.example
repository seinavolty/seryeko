ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://seryeko:seryeko_local_dev@localhost:5432/seryeko
JWT_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# PayMongo (QR Ph checkout). Defaults use mock keys for local sandbox.
# Replace with real test/live keys from https://dashboard.paymongo.com
PAYMONGO_PUBLIC_KEY=pk_test_seryeko_mock_public
PAYMONGO_SECRET_KEY=sk_test_seryeko_mock_secret
PAYMONGO_WEBHOOK_SECRET=whsec_mock_secret

# Webhook URL to register in PayMongo Dashboard → Developers → Webhooks:
#   https://<your-api-host>/api/webhooks/paymongo
# Events: payment.paid, payment.failed, qrph.expired

# DramaBuzz API Key (for content aggregator)
DRAMABUZZ_API_KEY=
